MONGO_URI=mongodb://localhost:27017/examguard_ai_db
NODE_ENV=development
SERVE_STATIC=false
PORT=3011

APP_NAME=ExamGuard AI
APP_DOMAIN=localhost
VITE_DOMAIN=localhost
COOKIE_DOMAIN=

# Bảo mật JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES=7d

# Đường dẫn lưu trữ dữ liệu
UPLOAD_DIR=./uploads
RESOURCE_UPLOAD_DIR=./uploads/data
PROJECT_DIR=./
FACE_DATA_DIR=./face_data

# Bảo mật kết nối nội bộ Node.js Core <-> Python Face AI
INTERNAL_AI_SECRET=ExamGuard_AI_Internal_Microservice_Secret_Key_999
REQUIRE_HMAC_AUTH=true

# Kết nối microservice Python Face AI
FACE_AI_URL=http://127.0.0.1:8000
FACE_AI_HOST=127.0.0.1
FACE_AI_PORT=8000
