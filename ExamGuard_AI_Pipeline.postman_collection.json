		{
			"name": "01. Authentication & Onboarding (Identity)",
			"item": [
				{
					"name": "1.1 Đăng nhập Thí sinh (Lục Văn Sơn)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"student_token\", jsonData.token);",
									"    console.log(\"Saved student_token:\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"son.luc@sinhvien.edu.vn\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/auth/login",
							"host": ["{{base_url_core}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Đăng nhập sinh viên Lục Văn Sơn, tự động lưu token vào student_token"
					},
					"response": []
				},
				{
					"name": "1.2 Đăng nhập Giảng viên / Giám thị",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"teacher_token\", jsonData.token);",
									"    console.log(\"Saved teacher_token:\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"anguyen@examguard.edu.vn\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/auth/login",
							"host": ["{{base_url_core}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Đăng nhập Giảng viên / Giám thị, tự động lưu teacher_token"
					},
					"response": []
				},
				{
					"name": "1.3 Kiểm tra trạng thái KYC khuôn mặt Thí sinh",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/face/registration-status/2310900087",
							"host": ["{{base_url_core}}"],
							"path": ["api", "face", "registration-status", "2310900087"]
						},
						"description": "Kiểm tra sinh viên 2310900087 đã được trích xuất 5 góc khuôn mặt chưa"
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Exam Preparation & Scheduling (Teacher/Admin)",
			"item": [
				{
					"name": "2.1 Lấy danh sách Ngân hàng Đề thi",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/exams/papers",
							"host": ["{{base_url_core}}"],
							"path": ["api", "exams", "papers"]
						},
						"description": "Lấy danh sách đề thi đã soạn (bao gồm DE-C-2026-01)"
					},
					"response": []
				},
				{
					"name": "2.2 Lấy danh sách Ca thi (Exam Sessions)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"var sessions = jsonData.data || jsonData;",
									"if (Array.isArray(sessions) && sessions.length > 0) {",
									"    var target = sessions.find(s => s.code === 'CA-20261015-01') || sessions[0];",
									"    pm.environment.set(\"session_id\", target._id || target.id);",
									"    console.log(\"Saved session_id:\", target._id || target.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/exams/sessions",
							"host": ["{{base_url_core}}"],
							"path": ["api", "exams", "sessions"]
						},
						"description": "Lấy danh sách ca thi và tự động lưu session_id của Ca 1 (P302)"
					},
					"response": []
				},
				{
					"name": "2.3 Lấy chi tiết Ca thi & Danh sách chỗ ngồi",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"var candidates = jsonData.data ? jsonData.data.candidates : jsonData.candidates;",
									"if (candidates && candidates.length > 0) {",
									"    var me = candidates.find(c => c.candidateCode === '20261015-001') || candidates[0];",
									"    pm.environment.set(\"session_student_id\", me._id || me.id);",
									"    console.log(\"Saved session_student_id:\", me._id || me.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/exams/sessions/{{session_id}}",
							"host": ["{{base_url_core}}"],
							"path": ["api", "exams", "sessions", "{{session_id}}"]
						},
						"description": "Lấy chi tiết phòng thi P302 và lấy session_student_id của thí sinh Lục Văn Sơn (20261015-001)"
					},
					"response": []
				}
			]
		},
		{
			"name": "03. Student Check-In Gate & Exam Taking",
			"item": [
				{
					"name": "3.1 Lấy đề thi đã tẩy dữ liệu nhạy cảm (Zero-Knowledge Questions)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/exams/questions/{{session_student_id}}",
							"host": ["{{base_url_core}}"],
							"path": ["api", "exams", "questions", "{{session_student_id}}"]
						},
						"description": "Kiểm tra API bảo mật: Đề thi trả về cho thí sinh hoàn toàn KHÔNG có đáp án đúng (correctAnswer) và giải thích (explanation)"
					},
					"response": []
				},
				{
					"name": "3.2 Thí sinh lưu tiến độ bài làm (Save Progress)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionStudentId\": \"{{session_student_id}}\",\n  \"currentQuestionIndex\": 5,\n  \"answers\": {\n    \"0\": 1,\n    \"1\": 2,\n    \"2\": 1,\n    \"3\": 0,\n    \"4\": 1\n  }\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/exams/save-progress",
							"host": ["{{base_url_core}}"],
							"path": ["api", "exams", "save-progress"]
						},
						"description": "Auto-save câu trả lời theo thời gian thực đề phòng mất điện hoặc rớt mạng"
					},
					"response": []
				},
				{
					"name": "3.3 Thí sinh nộp bài thi (Submit Exam & Auto-Grading)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionStudentId\": \"{{session_student_id}}\",\n  \"answers\": {\n    \"0\": 1,\n    \"1\": 2,\n    \"2\": 1,\n    \"3\": 0,\n    \"4\": 1,\n    \"5\": 1,\n    \"6\": 2,\n    \"7\": 0,\n    \"8\": 1,\n    \"9\": 2,\n    \"10\": 2,\n    \"11\": 2,\n    \"12\": 2,\n    \"13\": 1,\n    \"14\": 1,\n    \"15\": 2,\n    \"16\": 1,\n    \"17\": 1,\n    \"18\": \"Truyền tham trị sao chép giá trị, con trỏ truyền địa chỉ ô nhớ.\",\n    \"19\": \"int countEven(int a[], int n) { int c=0; for(int i=0;i<n;i++) if(a[i]%2==0) c++; return c; }\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/exams/submit",
							"host": ["{{base_url_core}}"],
							"path": ["api", "exams", "submit"]
						},
						"description": "Nộp bài thi và kích hoạt Chấm điểm tự động tức thì (Auto-grading Engine)"
					},
					"response": []
				}
			]
		},
		{
			"name": "04. Realtime AI Proctoring & Anti-Cheat Suite",
			"item": [
				{
					"name": "4.1 Lấy trạng thái phòng thi trực tiếp 3D (Live Room State)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/proctor/live/{{session_id}}",
							"host": ["{{base_url_core}}"],
							"path": ["api", "proctor", "live", "{{session_id}}"]
						},
						"description": "Lấy sơ đồ ma trận chỗ ngồi phòng P302 và trạng thái từng thí sinh (Trust Score, Bàn thi)"
					},
					"response": []
				},
				{
					"name": "4.2 Giả lập vi phạm chống gian lận trình duyệt (Tab Switch)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionId\": \"{{session_id}}\",\n  \"studentId\": \"{{session_student_id}}\",\n  \"eventType\": \"TAB_SWITCH\",\n  \"details\": \"Thí sinh chuyển sang tab trình duyệt khác\"\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/proctor/anti-cheat-event",
							"host": ["{{base_url_core}}"],
							"path": ["api", "proctor", "anti-cheat-event"]
						},
						"description": "Bắn sự kiện vi phạm chuyển Tab, hệ thống tự động trừ điểm uy tín (Trust Score)"
					},
					"response": []
				},
				{
					"name": "4.3 Giám thị phát lệnh cảnh báo thí sinh (Send Warning)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionId\": \"{{session_id}}\",\n  \"sessionStudentId\": \"{{session_student_id}}\",\n  \"message\": \"Yêu cầu bạn ngồi thẳng và nhìn trực diện vào màn hình!\"\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/proctor/send-warning",
							"host": ["{{base_url_core}}"],
							"path": ["api", "proctor", "send-warning"]
						},
						"description": "Gửi thông điệp cảnh báo trực tiếp lên màn hình thí sinh"
					},
					"response": []
				},
				{
					"name": "4.4 Giám thị cộng bù giờ cho thí sinh (Extra Time)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionId\": \"{{session_id}}\",\n  \"sessionStudentId\": \"{{session_student_id}}\",\n  \"extraMinutes\": 5,\n  \"reason\": \"Sự cố mạng chập chờn 5 phút đầu\"\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/proctor/extra-time",
							"host": ["{{base_url_core}}"],
							"path": ["api", "proctor", "extra-time"]
						},
						"description": "Cộng thêm 5 phút bù giờ cho bài thi của thí sinh"
					},
					"response": []
				}
			]
		},
		{
			"name": "05. Teacher Single-Review & Grade Publishing",
			"item": [
				{
					"name": "5.1 Workspace rà soát 1 lần & Cảnh báo sai đề",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/grading/review/{{session_id}}",
							"host": ["{{base_url_core}}"],
							"path": ["api", "grading", "review", "{{session_id}}"]
						},
						"description": "Giảng viên xem thống kê phổ điểm, danh sách câu hỏi và cảnh báo bất thường (Miskey Alert)"
					},
					"response": []
				},
				{
					"name": "5.2 Công nhận thêm đáp án đúng / Sửa đáp án đề thi",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionId\": \"{{session_id}}\",\n  \"questionId\": \"13\",\n  \"action\": \"ADD_VALID_ANSWER\",\n  \"acceptedAnswers\": [0, 1],\n  \"reason\": \"Công nhận cả 2 phương án do câu hỏi có cách diễn đạt mở\"\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/grading/adjust-question",
							"host": ["{{base_url_core}}"],
							"path": ["api", "grading", "adjust-question"]
						},
						"description": "Sửa hoặc công nhận thêm đáp án đúng cho câu hỏi số 14"
					},
					"response": []
				},
				{
					"name": "5.3 Chấm lại tức thì toàn bộ ca thi (1-Click Recalculate)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/grading/recalculate/{{session_id}}",
							"host": ["{{base_url_core}}"],
							"path": ["api", "grading", "recalculate", "{{session_id}}"]
						},
						"description": "Cập nhật điểm số cho toàn bộ thí sinh trong phòng sau khi sửa đề chỉ trong 1.5 giây"
					},
					"response": []
				},
				{
					"name": "5.4 Giảng viên ký duyệt bảng điểm (Approve Grades)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacher_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reviewNotes\": \"Đã kiểm tra kỹ 20 bài thi, xác nhận dữ liệu chính xác.\"\n}"
						},
						"url": {
							"raw": "{{base_url_core}}/api/grading/approve/{{session_id}}",
							"host": ["{{base_url_core}}"],
							"path": ["api", "grading", "approve", "{{session_id}}"]
						},
						"description": "Phê duyệt điểm số, chuyển trạng thái ca thi sang APPROVED"
					},
					"response": []
				},
				{
					"name": "5.5 Thí sinh xem kết quả chi tiết & Lời giải thích",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_token}}"
							}
						],
						"url": {
							"raw": "{{base_url_core}}/api/exams/results/{{session_student_id}}",
							"host": ["{{base_url_core}}"],
							"path": ["api", "exams", "results", "{{session_student_id}}"]
						},
						"description": "Sau khi công bố điểm, Thí sinh tra cứu kết quả kèm đáp án chuẩn và giải thích sư phạm"
					},
					"response": []
				}
			]
		}
	],
