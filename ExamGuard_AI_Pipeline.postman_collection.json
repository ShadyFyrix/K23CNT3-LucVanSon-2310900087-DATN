{
	"info": {
		"_postman_id": "examguard-ai-pipeline-v3",
		"name": "ExamGuard AI - E2E Testing Pipeline",
		"description": "Bộ sưu tập kiểm thử toàn diện End-to-End theo đúng luồng Pipeline của Hệ thống Thi trực tuyến ExamGuard AI (Sinh viên Lục Văn Sơn - 2310900087 - K23CNT3). Hỗ trợ kiểm thử tự động lưu Token, SessionId, CandidateId.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "00. System Healthcheck & Polyglot Sync",
			"item": [
				{
					"name": "0.1 Healthcheck Core Server (Port 3011)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url_core}}/api/face/health",
							"host": ["{{base_url_core}}"],
							"path": ["api", "face", "health"]
						},
