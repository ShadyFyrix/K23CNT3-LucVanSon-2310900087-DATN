					},
					"response": []
				},
				{
					"name": "0.2 Healthcheck Python Face AI (Port 8000)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url_ai}}/health",
							"host": ["{{base_url_ai}}"],
							"path": ["health"]
