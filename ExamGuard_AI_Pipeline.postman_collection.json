    {
      "name": "02. Exam Preparation & Scheduling (Teacher/Admin)",
      "item": [
        {
          "name": "2.1 Lấy danh sách Ngân hàng Đề thi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_core}}/api/exams/papers",
              "host": [
                "{{base_url_core}}"
              ],
              "path": [
                "api",
                "exams",
                "papers"
              ]
            },
            "description": "Lấy danh sách đề thi đã soạn (bao gồm DE-C-2026-01)"
          },
          "response": []
        },
        {
          "name": "2.2 Lấy danh sách Ca thi (Exam Sessions)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var sessions = jsonData.data || jsonData;",
                  "if (Array.isArray(sessions) && sessions.length > 0) {",
                  "    var target = sessions.find(s => s.code === 'CA-20261015-01') || sessions[0];",
                  "    pm.environment.set(\"session_id\", target._id || target.id);",
                  "    console.log(\"Saved session_id:\", target._id || target.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_core}}/api/exams/sessions",
              "host": [
                "{{base_url_core}}"
              ],
              "path": [
                "api",
                "exams",
                "sessions"
              ]
            },
            "description": "Lấy danh sách ca thi và tự động lưu session_id của Ca 1 (P302)"
          },
          "response": []
        },
        {
          "name": "2.3 Lấy chi tiết Ca thi & Danh sách chỗ ngồi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var candidates = jsonData.data ? jsonData.data.candidates : jsonData.candidates;",
                  "if (candidates && candidates.length > 0) {",
                  "    var me = candidates.find(c => c.candidateCode === '20261015-001') || candidates[0];",
                  "    pm.environment.set(\"session_student_id\", me._id || me.id);",
                  "    console.log(\"Saved session_student_id:\", me._id || me.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_core}}/api/exams/sessions/{{session_id}}",
              "host": [
                "{{base_url_core}}"
              ],
              "path": [
                "api",
                "exams",
                "sessions",
                "{{session_id}}"
              ]
            },
            "description": "Lấy chi tiết phòng thi P302 và lấy session_student_id của thí sinh Lục Văn Sơn (20261015-001)"
          },
          "response": []
        }
      ]
