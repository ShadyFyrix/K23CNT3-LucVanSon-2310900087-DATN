# ==============================================================================
# EXAMGUARD AI - FACE AI MICROSERVICE CONFIGURATION TEMPLATE
# ==============================================================================

NODE_ENV=development

# Database MongoDB
MONGO_URI=mongodb://localhost:27017/examguard_ai_db
MONGODB_URI=mongodb://localhost:27017/examguard_ai_db
MONGODB_DB_NAME=examguard_ai_db

# Bảo mật gọi chéo nội bộ (Node.js Core <-> Python Face AI Microservice)
INTERNAL_AI_SECRET=ExamGuard_AI_Internal_Microservice_Secret_Key_999
REQUIRE_HMAC_AUTH=true

# Python Face AI Microservice (Port 8000)
FACE_AI_HOST=127.0.0.1
FACE_AI_PORT=8000
STORAGE_TYPE=mongodb
FACE_DATA_DIR=./data
