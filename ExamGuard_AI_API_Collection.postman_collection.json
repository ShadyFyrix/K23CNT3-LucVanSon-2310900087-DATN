              "mode": "raw",
              "raw": "{\n  \"code\": \"INT101_CK_2026\",\n  \"title\": \"Đề thi Kết thúc Học phần Kỹ thuật Lập trình C\",\n  \"subject\": \"Kỹ thuật lập trình C\",\n  \"durationMinutes\": 60,\n  \"totalScore\": 10,\n  \"paperType\": \"STRUCTURED_QUIZ\",\n  \"structureType\": \"PURE_MCQ\",\n  \"shuffleQuestions\": true,\n  \"shuffleOptions\": true,\n  \"questions\": [\n    {\n      \"stt\": 1,\n      \"type\": \"MULTIPLE_CHOICE\",\n      \"content\": \"Trong ngôn ngữ C, kiểu dữ liệu nào sau đây chiếm 4 bytes trên kiến trúc 32-bit thông dụng?\",\n      \"options\": [\n        \"char\",\n        \"int\",\n        \"double\",\n        \"short\"\n      ],\n      \"correctAnswer\": 1,\n      \"correctAnswers\": [\n        1\n      ],\n      \"score\": 2.5,\n      \"explanation\": \"Kiểu int thông thường chiếm 4 bytes (32 bits) trong C/C++.\"\n    },\n    {\n      \"stt\": 2,\n      \"type\": \"MULTIPLE_CHOICE\",\n      \"content\": \"Cấu trúc dữ liệu nào hoạt động theo nguyên lý LIFO (Last In First Out)?\",\n      \"options\": [\n        \"Queue\",\n        \"Tree\",\n        \"Stack\",\n        \"Linked List\"\n      ],\n      \"correctAnswer\": 2,\n      \"correctAnswers\": [\n        2\n      ],\n      \"score\": 2.5,\n      \"explanation\": \"Stack hoạt động theo cơ chế LIFO.\"\n    }\n  ]\n}"
