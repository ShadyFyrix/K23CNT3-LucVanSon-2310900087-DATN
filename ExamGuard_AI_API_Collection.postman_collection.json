  "item": [
    {
      "name": "01. Xác thực & Tài khoản (Auth)",
      "item": [
        {
          "name": "Đăng nhập Admin Khảo thí (Auto Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token || (jsonData.data && jsonData.data.token)) {",
                  "    var token = jsonData.token || jsonData.data.token;",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token updated successfully!');",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{defaultPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập bằng tài khoản Quản trị Khảo thí và tự động gán token vào biến {{token}}."
          }
        },
